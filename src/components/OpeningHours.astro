---
import { openingHours } from '../content';
import { berlinToday } from '../lib/dates.ts';
import { formatRange, weekdayLabels } from '../lib/opening-hours.ts';
import { weekdays } from '../lib/weekdays.ts';

const today = berlinToday(new Date()).weekday;
---

<div class="max-w-xl">
  <table class="opening-hours w-full border-collapse text-left">
    <caption class="sr-only">Öffnungszeiten nach Wochentag</caption>
    <thead class="sr-only">
      <tr>
        <th scope="col">Wochentag</th>
        <th scope="col">Geöffnet</th>
      </tr>
    </thead>
    <tbody>
      {weekdays.map((day) => {
        const ranges = openingHours.days[day];

        return (
          <tr
            data-weekday={day}
            aria-current={day === today ? 'date' : undefined}
            class="border-line border-b last:border-b-0"
          >
            <th scope="row" class="px-2 py-3 align-top font-semibold sm:px-3">
              {weekdayLabels[day]}
            </th>
            <td class="px-2 py-3 align-top sm:px-3">
              {ranges.length === 0 ? (
                <span class="text-muted">geschlossen</span>
              ) : (
                ranges.map((range) => (
                  <span class="block whitespace-nowrap">
                    {formatRange(range)}
                  </span>
                ))
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <p class="text-muted mt-4" data-hours-note hidden={!openingHours.note}>
    {openingHours.note}
  </p>
</div>
