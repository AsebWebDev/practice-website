---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3 text-base font-semibold no-underline transition-colors',
    variant === 'primary' && 'bg-accent text-on-accent hover:bg-accent-strong',
    variant === 'secondary' &&
      'border-accent text-accent-strong hover:bg-tint border-2 bg-surface',
  ]}
>
  <slot />
</a>
