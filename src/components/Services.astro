---
import { services } from '../content';
import ServiceIcon from './ServiceIcon.astro';
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {services.map((service) => (
    <li class="border-line bg-surface rounded-2xl border p-6">
      <span class="bg-tint text-accent-strong inline-flex size-12 items-center justify-center rounded-full">
        <ServiceIcon name={service.icon} />
      </span>
      <h3 class="font-heading mt-4 text-lg font-semibold">{service.title}</h3>
      <p class="text-muted mt-2">{service.description}</p>
    </li>
  ))}
</ul>
