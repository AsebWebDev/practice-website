---
interface Props {
  id: string;
  title: string;
  tinted?: boolean;
}

const { id, title, tinted = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['scroll-mt-4 py-12 sm:py-16', tinted && 'bg-tint']}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 id={headingId} class="font-heading text-2xl font-semibold sm:text-3xl">
      {title}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
